# ────────────────────────────────────────────────────────────────
# Oryvia — environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# The app runs fully offline with zero keys (local heuristic AI).
# ────────────────────────────────────────────────────────────────

# ── Secrets ─────────────────────────────────────────────────────
# JWT signing secret (HS256). Generate with: openssl rand -base64 48
ORVYIA_JWT_SECRET=

# Master encryption key (AES-256). 64 hex chars.
# Generate with: openssl rand -hex 32
# If empty in dev, a key is derived from ORVYIA_JWT_SECRET (or a dev
# fallback) so photos are still encrypted at rest.
ORVYIA_ENC_KEY=

# ── AI providers (optional — pick at least one for "real" AI) ──
# Without any key the app uses Oryvia's built-in Local Fashion Engine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Supabase (optional — production Postgres/Auth/Storage) ──────
# When set, Oryvia can run against Supabase instead of local SQLite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
